BOT_TOKEN=8446582877:AAGefQGsrW0IijsDWp4HETX2GfAiBiwxjaE

# Prefix Detection Mode Configuration
# Set to "strict" to ONLY process messages with "Time Span Agent Name" prefix
# Set to "flexible" to process all messages but give priority to those with prefix

#PREFIX_DETECTION_MODE=flexible
PREFIX_DETECTION_MODE=strict

# Auto-Delete User Stats Messages Configuration
# Set to "true" to automatically delete user's stats messages after processing
# This keeps the chat clean and prevents others from copying stats
# REQUIRES: Bot must have admin privileges with "delete messages" permission

AUTO_DELETE_USER_STATS=true
#AUTO_DELETE_USER_STATS=false

# Delay (in seconds) before deleting user's message
# Default: 2 seconds (gives user time to see their message was received)
AUTO_DELETE_DELAY_SECONDS=2

# Admin User IDs for Broadcast Feature
# Comma-separated list of Telegram user IDs who can use the /broadcast command
# To find your Telegram user ID, message @userinfobot on Telegram
# Example: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=574747247
